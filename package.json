{
  "name": "vihar-games",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test src/games/tic-tac-toe/*.test.ts src/games/chess/*.test.ts src/games/carrom/*.test.ts src/games/paperwing/*.test.ts src/games/sudoku/*.test.ts src/games/dune-dash/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
